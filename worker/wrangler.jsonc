{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "situation-puzzle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "d1_databases": [{ "binding": "DB", "database_name": "Situation-Puzzle", "database_id": "95263075-f381-4469-b336-95e312b03a92", "migrations_dir": "migrations" }],
  "vars": { "ALLOWED_ORIGIN": "https://puzzle.xiaobaozi.cn,https://www.bilibili.com,https://www.bilibilitoy.com", "JEV_CONFIDENCE_THRESHOLD": "0.5" },
  "secrets": { "required": ["AI_GATEWAY_API_KEY", "ADMIN_TOKEN", "BILIBILI_APP_ID", "BILIBILI_APP_SECRET", "XHS_APP_ID", "XHS_APP_SECRET"] },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
