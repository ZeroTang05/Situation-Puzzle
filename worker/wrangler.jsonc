{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jev-turtle-soup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "d1_databases": [{ "binding": "DB", "database_name": "jev-turtle-soup", "database_id": "请在创建 D1 数据库后填入这里", "migrations_dir": "migrations" }],
  "vars": { "ALLOWED_ORIGIN": "http://localhost:3000", "JEV_CONFIDENCE_THRESHOLD": "0.4" },
  "secrets": { "required": ["AI_GATEWAY_API_KEY", "ADMIN_TOKEN", "BILIBILI_APP_ID", "BILIBILI_APP_SECRET", "XHS_APP_ID", "XHS_APP_SECRET"] }
}
