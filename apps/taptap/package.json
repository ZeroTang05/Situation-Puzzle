{
  "name": "@jev/taptap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "超好玩海龟汤 TapTap 小游戏",
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && node scripts/build.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "tsx scripts/e2e.mts",
    "e2e:auth": "tsx scripts/e2e-auth.mts",
    "e2e:review": "tsx scripts/e2e-review.mts",
    "check:viewport": "tsx scripts/check-viewport.mts",
    "check:ads": "tsx scripts/check-ad-policy.mts",
    "package": "node scripts/package.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@jev/contracts": "workspace:*",
    "@jev/i18n": "workspace:*",
    "react": "19.3.0",
    "react-reconciler": "0.34.0",
    "css-layout": "1.1.1",
    "@tanstack/react-query": "^5.83.0",
    "abort-controller": "^3.0.0",
    "core-js": "3.51.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-reconciler": "^0.33.0",
    "archiver": "^7.0.1",
    "qrcode": "^1.5.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "tsx": "^4.20.3"
  }
}
